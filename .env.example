# Database (Neon PostgreSQL)
DATABASE_URL = Pooled connection (for app queries, with -pooler in hostname)
DIRECT_URL = Direct connection (for Prisma migrations, without -pooler)

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# LINE Login
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Database script safety flags (optional)
# Set only when you intentionally need these scripts:
# - ALLOW_NON_LOCAL_SEED=true (allows seed.ts against non-local DB)
# - ALLOW_PROD_INIT=true + PROD_INIT_CONFIRM=INIT_PRODUCTION_ADMINS
# - ALLOW_LOCAL_PROD_INIT=true (only for local testing of init-production.ts)
ALLOW_NON_LOCAL_SEED=false
ALLOW_PROD_INIT=false
PROD_INIT_CONFIRM=
ALLOW_LOCAL_PROD_INIT=false

# Neon API (for migration guardrails — production only)
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id
NEON_BRANCH_ID=your-neon-production-branch-id
