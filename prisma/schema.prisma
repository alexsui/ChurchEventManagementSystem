generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum Role {
  ADMIN         // 統籌者
  STAFF_ADMIN   // 行政同工
  STAFF_GENERAL // 總務同工
  STAFF_FINANCE // 財務同工
  PASTOR        // 傳道人
  STAFF_MEDIA   // 多媒體同工
  TEAM_LEADER   // 組長
  MEMBER        // 一般會員
}

enum EventType {
  SINGLE // 單場活動
  SERIES // 系列活動
}

enum EventStatus {
  PLANNING    // 企劃中
  OPEN        // 報名中
  IN_PROGRESS // 進行中
  COMPLETED   // 已結束
}


enum EventCategory {
  COURSE  // 課程
  LECTURE // 講座
  CAMP    // 營會
}

enum RegistrationStatus {
  REGISTERED // 已報名
  CANCELLED  // 已取消
  WAITLISTED // 候補中
}

enum FormFieldType {
  TEXT          // 文字
  YES_NO        // 是否
  SINGLE_CHOICE // 單選
}

// ==================== NextAuth.js Tables ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== Application Tables ====================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  phone               String?   @unique
  password            String?
  role                Role      @default(MEMBER)
  permissionExpiresAt DateTime?
  isActive            Boolean   @default(true)
  profileCompleted    Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
  attendances   Attendance[]
  assignmentCompletions AssignmentCompletion[] @relation("assignmentCompletions")
  assignmentCompletedBy AssignmentCompletion[] @relation("assignmentCompletedBy")
  eventTeamMembers       EventTeamMember[]
  assignedTasks          EventTeamTask[]
  teamDefaultMemberships TeamDefaultMember[]
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTeams     EventTeam[]
  defaultMembers TeamDefaultMember[]
  defaultTasks   TeamDefaultTask[]
}

model TeamDefaultMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamDefaultTask {
  id        String   @id @default(cuid())
  teamId    String
  title     String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model EventTeam {
  id         String   @id @default(cuid())
  eventId    String
  teamId     String?
  customName String?
  sopLinks   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?  @relation(fields: [teamId], references: [id])
  members EventTeamMember[]
  tasks   EventTeamTask[]

  @@unique([eventId, teamId])
}

model EventTeamMember {
  id          String   @id @default(cuid())
  eventTeamId String
  userId      String
  role        String?
  createdAt   DateTime @default(now())

  eventTeam EventTeam @relation(fields: [eventTeamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventTeamId, userId])
}

model EventTeamTask {
  id          String   @id @default(cuid())
  eventTeamId String
  title       String
  assigneeId  String?
  status      String   @default("PENDING")
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventTeam EventTeam @relation(fields: [eventTeamId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id])
}

model Event {
  id               String           @id @default(cuid())
  title            String
  description      String?          @db.Text
  location         String?
  category         EventCategory?
  type             EventType        @default(SINGLE)
  status           EventStatus      @default(PLANNING)

  maxParticipants  Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  minAssignmentRate Float?

  eventSessions EventSession[]
  registrations Registration[]
  eventTeams    EventTeam[]
  budgetItems   BudgetItem[]
  formFields    EventFormField[]
}

model EventSession {
  id          String   @id @default(cuid())
  eventId     String
  sessionNo   Int
  sessionDate DateTime
  startTime   String?
  endTime     String?
  topic       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  assignments Assignment[]

  @@unique([eventId, sessionNo])
}

model Registration {
  id        String             @id @default(cuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formResponses EventFormResponse[]

  @@unique([userId, eventId])
}

model Attendance {
  id             String   @id @default(cuid())
  userId         String
  eventSessionId String
  isLate         Boolean  @default(false)
  lateMinutes    Int?
  checkedInAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSession EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventSessionId])
}

model RolePermission {
  id      String  @id @default(cuid())
  role    Role
  module  String
  action  String
  allowed Boolean @default(false)

  @@unique([role, module, action])
}

model Assignment {
  id             String   @id @default(cuid())
  eventSessionId String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  eventSession EventSession          @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  completions  AssignmentCompletion[]
}

model AssignmentCompletion {
  id            String   @id @default(cuid())
  assignmentId  String
  userId        String
  completedAt   DateTime @default(now())
  completedById String

  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User       @relation("assignmentCompletions", fields: [userId], references: [id], onDelete: Cascade)
  completedBy User       @relation("assignmentCompletedBy", fields: [completedById], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

model BudgetItem {
  id             String   @id @default(cuid())
  eventId        String
  category       String   // MEAL, SNACK, VENUE, MATERIAL, EQUIPMENT, OTHER
  customCategory String?
  estimated      Float
  actual         Float    @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ==================== Custom Registration Form ====================

model EventFormField {
  id        String        @id @default(cuid())
  eventId   String
  type      FormFieldType
  label     String
  options   String[]
  required  Boolean       @default(false)
  sortOrder Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses EventFormResponse[]
}

model EventFormResponse {
  id             String   @id @default(cuid())
  registrationId String
  fieldId        String
  value          String
  createdAt      DateTime @default(now())

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  field        EventFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([registrationId, fieldId])
}
