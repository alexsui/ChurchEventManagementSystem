generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum Role {
  ADMIN         // 統籌者
  STAFF_ADMIN   // 行政同工
  STAFF_GENERAL // 總務同工
  STAFF_FINANCE // 財務同工
  PASTOR        // 傳道人
  STAFF_MEDIA   // 多媒體同工
  TEAM_LEADER   // 組長
  MEMBER        // 一般會員
}

enum EventType {
  SINGLE // 單場活動
  SERIES // 系列活動
}

enum EventStatus {
  PLANNING    // 企劃中
  OPEN        // 報名中
  IN_PROGRESS // 進行中
  COMPLETED   // 已結束
}

enum RegistrationMode {
  PER_SESSION // 單場報名
  FULL_SERIES // 整期報名
}

enum EventCategory {
  COURSE  // 課程
  LECTURE // 講座
  CAMP    // 營會
}

enum RegistrationStatus {
  REGISTERED // 已報名
  CANCELLED  // 已取消
  WAITLISTED // 候補中
}

// ==================== NextAuth.js Tables ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== Application Tables ====================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  phone               String?   @unique
  password            String?
  role                Role      @default(MEMBER)
  teamId              String?
  permissionExpiresAt DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  team          Team?          @relation(fields: [teamId], references: [id])
  registrations Registration[]
  attendances   Attendance[]
  assignmentCompletions AssignmentCompletion[] @relation("assignmentCompletions")
  assignmentCompletedBy AssignmentCompletion[] @relation("assignmentCompletedBy")
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Event {
  id               String           @id @default(cuid())
  title            String
  description      String?          @db.Text
  location         String?
  category         EventCategory?
  type             EventType        @default(SINGLE)
  status           EventStatus      @default(PLANNING)
  registrationMode RegistrationMode @default(FULL_SERIES)
  maxParticipants  Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  minAssignmentRate Float?

  eventSessions EventSession[]
  registrations Registration[]
  budgetItems   BudgetItem[]
}

model EventSession {
  id          String   @id @default(cuid())
  eventId     String
  sessionNo   Int
  sessionDate DateTime
  startTime   String?
  endTime     String?
  topic       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  assignments Assignment[]

  @@unique([eventId, sessionNo])
}

model Registration {
  id        String             @id @default(cuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Attendance {
  id             String   @id @default(cuid())
  userId         String
  eventSessionId String
  isLate         Boolean  @default(false)
  lateMinutes    Int?
  checkedInAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSession EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventSessionId])
}

model RolePermission {
  id      String  @id @default(cuid())
  role    Role
  module  String
  action  String
  allowed Boolean @default(false)

  @@unique([role, module, action])
}

model Assignment {
  id             String   @id @default(cuid())
  eventSessionId String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  eventSession EventSession          @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  completions  AssignmentCompletion[]
}

model AssignmentCompletion {
  id            String   @id @default(cuid())
  assignmentId  String
  userId        String
  completedAt   DateTime @default(now())
  completedById String

  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User       @relation("assignmentCompletions", fields: [userId], references: [id], onDelete: Cascade)
  completedBy User       @relation("assignmentCompletedBy", fields: [completedById], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

model BudgetItem {
  id             String   @id @default(cuid())
  eventId        String
  category       String   // MEAL, SNACK, VENUE, MATERIAL, EQUIPMENT, OTHER
  customCategory String?
  estimated      Float
  actual         Float    @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
